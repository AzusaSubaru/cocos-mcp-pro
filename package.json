{
  "name": "cocos-mcp-pro-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "开源、跨 AI 客户端的 Cocos Creator 社区 MCP 服务器（monorepo 根）",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @cocos-mcp/shared run build",
    "build:extension": "pnpm --filter cocos-mcp-bridge run build",
    "build:server": "pnpm --filter cocos-mcp-pro run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rimraf dist"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
